# HTTPS (automatic Let's Encrypt certificate) and routing for the single-server deployment.
{
	email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	# Internal endpoints (voice engine -> backend) are reachable only on the Docker network.
	@internal path /api/v1/internal/*
	respond @internal 404

	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}
}
