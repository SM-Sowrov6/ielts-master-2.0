# Server environment for infrastructure/deploy/compose.prod.yml.
# Copy to infrastructure/deploy/.env on the server (chmod 600). Never commit the filled-in file.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# --- Site -----------------------------------------------------------------------------------
DOMAIN=ieltsmaster.site
ACME_EMAIL=you@example.com
# production enforces staff 2FA (authenticator app), real SMTP and https.
APP_ENV=production
LOG_LEVEL=INFO

# --- Secrets (generate fresh values; do not reuse local ones) --------------------------------
POSTGRES_USER=ielts
POSTGRES_DB=ielts
POSTGRES_PASSWORD=
AUTH_SECRET_KEY=
SPEAKING_EVENTS_TOKEN=

# --- Accounts & access -----------------------------------------------------------------------
# Staff sign in with password + authenticator code (enrolled on first visit to /admin).
# Lost device and recovery codes: uv run python scripts/admin_cli.py reset-mfa EMAIL
STAFF_MFA_REQUIRED=true
# Staff-only uploads of Listening audio / images, verified by size, SHA-256 and file signature.
MEDIA_UPLOADS_ENABLED=true
# Public sign-up needs the approved legal documents (D-17). After approving /terms and /privacy
# (frontend/src/components/legal/legal-page.tsx, LEGAL_VERSION), set both versions and enable.
REGISTRATION_ENABLED=false
REGISTRATION_MINIMUM_AGE=16
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=

# --- Email (verification, password reset) ----------------------------------------------------
# Free options: Brevo (300 emails/day) or Resend (3,000/month). Use their SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
EMAIL_FROM=IELTS MASTER <no-reply@ieltsmaster.site>

# --- Media: Cloudflare R2 --------------------------------------------------------------------
# R2 > Manage API tokens > Object Read & Write for the bucket.
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ielts-media

# --- AI & voice ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
# Site assistant: OpenRouter free models (unset = uses GEMINI_API_KEY). See .env.example.
OPENROUTER_API_KEY=
# ASSISTANT_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# ASSISTANT_REASONING=on
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CANDIDATE_STT=deepgram/nova-3
EXAMINER_SILENCE_MS=1500
