{
  "name": "ielts-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "api:generate": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "livekit-client": "2.24.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
