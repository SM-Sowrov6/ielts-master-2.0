# IELTS MASTER 2.0 — local development environment template.
# Copy to `.env` and fill in values. `.env` is git-ignored. Never commit real secrets.
# All values below are placeholders for LOCAL development only.

# --- Runtime environment: local | ci | staging | production ---
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker compose and the backend) ---
POSTGRES_USER=ielts
POSTGRES_DB=ielts
# Required. Choose any local-only value; docker compose refuses to start without it.
POSTGRES_PASSWORD=change-me-local-only

# --- Backend ---
# When running the backend natively (outside Docker), point at the published local ports:
DATABASE_URL=postgresql://ielts:change-me-local-only@127.0.0.1:5432/ielts
REDIS_URL=redis://127.0.0.1:6379/0
# Seconds allowed for each readiness dependency check
READINESS_TIMEOUT_SECONDS=2.0
# Optional connection-pool tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_ECHO=false

# --- Authentication (docs/SECURITY_GUIDELINES.md §2-3) ---
# Required by docker compose and the outbox worker. Generate a random local value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
# Public origin of the web app (email links + CSRF Origin check). Never derived from requests.
PUBLIC_APP_URL=http://localhost:3000
# Optional extra origins for the CSRF Origin check (JSON list), e.g. when browsing via 127.0.0.1:
# CSRF_TRUSTED_ORIGINS=["http://127.0.0.1:3000"]
# Registration policy. D-13 (minimum age / parental consent) and D-17 (Terms & Privacy) are
# UNRESOLVED: local/ci show clearly marked development placeholders; every other environment
# keeps registration closed and refuses to start with it enabled until these are set.
# REGISTRATION_ENABLED=
# Minimum age decided by the Product Owner (D-13, 2026-11-18): 16+, no parental-consent flow.
REGISTRATION_MINIMUM_AGE=16
# LEGAL_TERMS_VERSION=
# LEGAL_PRIVACY_VERSION=
# Session lifetimes (defaults: 7 days idle, 30 days absolute)
# SESSION_IDLE_TTL_SECONDS=604800
# SESSION_ABSOLUTE_TTL_SECONDS=2592000

# --- Email (provider-neutral SMTP; local development uses Mailpit from docker compose) ---
# Running the backend/worker natively: Mailpit is published on 127.0.0.1:1025 (inbox :8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
EMAIL_FROM=IELTS MASTER <no-reply@ielts-master.localhost>
# Production (decision D-18): provider host, port 587 + SMTP_SECURITY=starttls (or 465 + ssl),
# SMTP_USERNAME / SMTP_PASSWORD from the secret store. SMTP_SECURITY=none is refused in production.
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Media storage (S3 API; local development uses MinIO from docker compose) ---
# Required by docker compose. Choose any local-only values (password: at least 8 characters).
MINIO_ROOT_USER=ielts-minio
MINIO_ROOT_PASSWORD=change-me-local-only
# Running the backend natively: MinIO is published on 127.0.0.1:9000 (console :9001).
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Origin browsers use for presigned upload/playback URLs (must be reachable from the browser).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=ielts-minio
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_BUCKET=ielts-media
# Uploads are refused outside local/ci until malware scanning exists (docs/ADMIN_CONSOLE.md).
# MEDIA_UPLOADS_ENABLED=
# MEDIA_MAX_AUDIO_BYTES=209715200
# MEDIA_MAX_IMAGE_BYTES=10485760

# --- AI Speaking Room voice engine (not connected yet; see docs/REALTIME_SPEAKING_ARCHITECTURE.md) ---
# Shared secret for POST /api/v1/internal/speaking/rooms/{id}/events. Unset = endpoint disabled.
SPEAKING_EVENTS_TOKEN=

# --- Integration tests (optional; used only by pytest) ---
# A role allowed to CREATE/DROP DATABASE; the suite manages its own `ielts_test` database.
# TEST_DATABASE_ADMIN_URL=postgresql://ielts:change-me-local-only@127.0.0.1:5432/postgres
# TEST_REDIS_URL=redis://127.0.0.1:6379/0
# Media tests use a separate `ielts-media-test` bucket on the local MinIO:
# TEST_S3_ENDPOINT_URL=http://127.0.0.1:9000
# TEST_S3_ACCESS_KEY_ID=ielts-minio
# TEST_S3_SECRET_ACCESS_KEY=change-me-local-only

# --- Frontend ---
# Server-side only (never exposed to the browser). Base URL of the backend API.
API_INTERNAL_URL=http://127.0.0.1:8000

# --- AI (Google AI Studio) ---
# Writing/Speaking evaluation and transcription. Unset = evaluations end "unavailable".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Voice examiner (voice-engine): Gemini Live model and API version.
GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_API_VERSION=v1alpha

# --- Site assistant (floating chat widget) ---
# OpenRouter key (https://openrouter.ai/keys). Unset = the assistant uses GEMINI_API_KEY; with
# neither key the widget shows "offline". Server-side only, never exposed to the browser.
OPENROUTER_API_KEY=
# Comma-separated model IDs tried in order. Only free models (":free" suffix or "openrouter/free")
# are accepted. Free model IDs change over time: check https://openrouter.ai/models?max_price=0
# ASSISTANT_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Hidden model reasoning: off | on | low | medium | high (on = slower but more careful answers).
# ASSISTANT_REASONING=on
# ASSISTANT_ENABLED=true
# ASSISTANT_TIMEOUT_SECONDS=25
# Messages per minute/day: guests (per IP) and signed-in users (per account).
# ASSISTANT_GUEST_PER_MINUTE=6
# ASSISTANT_GUEST_PER_DAY=40
# ASSISTANT_USER_PER_MINUTE=12
# ASSISTANT_USER_PER_DAY=200

# --- LiveKit (AI Speaking Room voice) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where the voice agent posts transcript events (the backend).
BACKEND_INTERNAL_URL=http://127.0.0.1:8001
# Candidate live captions: LiveKit Inference STT model (uses the LIVEKIT_* credentials), or "gemini".
CANDIDATE_STT=deepgram/nova-3
# Silence (ms) before the examiner treats an answer as finished.
EXAMINER_SILENCE_MS=1500
